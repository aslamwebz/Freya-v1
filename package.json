{
  "name": "freya",
  "version": "0.1.0",
  "private": true,
  "description": "Freya — a voice-first personal intelligence environment. Durable Core with an event journal, Guard, cognition Governor and a typed desktop host.",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-electron.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "start": "npm run build && node scripts/launch.mjs 2",
    "start:display2": "npm run build && node scripts/launch.mjs 2",
    "electron:dev": "node scripts/build-electron.mjs && electron . --dev",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.core.json --noEmit",
    "extension:typecheck": "tsc -p tsconfig.extension.json --noEmit",
    "extension:lint": "eslint extension",
    "extension:build": "node scripts/build-extension.mjs",
    "extension:verify": "npm run extension:typecheck && npm run extension:lint && npm run extension:build",
    "lint": "eslint .",
    "verify:lint": "eslint . && eslint extension",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit-core": "vitest run tests/unit tests/core",
    "test:host": "vitest run tests/host",
    "test:qualification": "vitest run tests/qualification",
    "test:scenario:startup-shutdown": "vitest run tests/qualification/scenarios/startup-shutdown.test.ts",
    "test:scenario:persistence-recovery": "vitest run tests/qualification/scenarios/persistence-recovery.test.ts",
    "test:scenario:stop-all": "vitest run tests/qualification/scenarios/stop-all.test.ts",
    "test:scenario:provider-lifecycle-security": "vitest run tests/qualification/scenarios/provider-lifecycle-security.test.ts",
    "test:scenario:runtime-activation-truth": "vitest run tests/qualification/scenarios/runtime-activation-truth.test.ts",
    "test:scenario:device-hands": "vitest run tests/qualification/scenarios/device-hands.test.ts",
    "test:scenario:browser-extension": "vitest run tests/qualification/scenarios/browser-extension.test.ts",
    "test:e2e": "node --experimental-strip-types tests/e2e/desktop.e2e.ts",
    "test:redteam": "vitest run tests/red-team",
    "core:model-probe": "node scripts/core-model-probe.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e",
    "release:check": "node scripts/release-check.mjs",
    "gauntlet": "npm run test:redteam",
    "release:gate": "npm run verify && npm run gauntlet && npm run release:check",
    "release:manifest": "node scripts/release-manifest.mjs",
    "qualify": "node scripts/qualify.mjs",
    "qualify:json": "node scripts/qualify.mjs --format=json",
    "test:chat-live": "vitest run tests/live",
    "test:chat-search": "vitest run tests/live/searxng-live.test.ts",
    "test:chat-acceptance": "vitest run tests/live/chat-acceptance.test.ts",
    "test:chat-browser": "npm run build:chat-browser-acceptance && electron dist-electron/acceptance-native-browser.cjs",
    "build:chat-browser-acceptance": "node scripts/build-chat-browser-acceptance.mjs",
    "test:chat-live-all": "npm run test:chat-acceptance && npm run test:chat-browser",
    "test:chat-onscreen": "node scripts/chat-onscreen-acceptance.mjs",
    "test:chat-random": "node scripts/chat-random.mjs",
    "test:chat-v2-shots": "node scripts/chat-v2-screenshot.mjs"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "pdfjs-dist": "4.10.38",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.49.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "npm@11.5.1"
}
