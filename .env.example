# Freya local environment — copy to `.env` (git-ignored) and fill in real values.
#
# Only the Electron main process and trusted Node scripts read this file.
# Nothing here crosses the preload bridge into the renderer, and no value here
# is ever written to the journal, a projection, a log line, or a chat transcript.
#
# NEVER commit a real key. `.env` is git-ignored; this template is tracked.

# NanoGPT provider (OpenAI-compatible API).
# A missing key leaves the provider `unconfigured` and chat refuses truthfully —
# Freya never fabricates an answer to look like it worked.
NANOGPT_API_KEY=
NANOGPT_BASE_URL=https://nano-gpt.com/api/v1

# Default model id for this install. It must be a callable text model id from
# NanoGPT's GET /models catalog (the model selector in Chat lists them live).
NANOGPT_MODEL=openai/gpt-4.1-nano

# The explicit decision to spend money on inference. Without this, a fully
# configured provider still reports `disabled` and no live call is possible.
# Set to 1 only if you really want live, billed model calls.
FREYA_ALLOW_LIVE_MODEL=0

# Phase 5 web research (optional; both are read only in the main process).
BRAVE_SEARCH_API_KEY=
FREYA_ALLOW_WEB_SEARCH=0
