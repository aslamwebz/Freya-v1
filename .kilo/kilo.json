{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "--yes",
        "@playwright/mcp@latest",
        "--cdp-endpoint",
        "http://127.0.0.1:9222"
      ],
      "environment": {},
      "enabled": true,
      "timeout": 30000
    }
  },
  "permission": {
    "mcp": {
      "playwright_*": "allow"
    }
  }
}
